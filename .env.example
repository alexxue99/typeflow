# Neon supplies these when the project is linked or its environment is pulled.
# Use the pooled URL for application traffic and the direct URL for migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Optional Neon Auth. NEON_AUTH_BASE_URL comes from Neon; create the cookie
# secret yourself and set the same value locally and in Vercel.
NEON_AUTH_BASE_URL=https://example.neonauth.example/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# A Neon environment pull may also add NEON_BRANCH, NEON_AUTH_JWKS_URL, and
# NEON_AI_GATEWAY_* variables. This app does not read them directly.
